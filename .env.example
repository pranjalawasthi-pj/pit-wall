# One universal OpenAI-compatible API connection. Keep this file private; never commit .env.
AI_API_KEY=
# Optional: endpoint root (defaults to https://api.openai.com/v1)
AI_BASE_URL=https://api.openai.com/v1
# Optional: vision-capable model name (defaults to gpt-4o-mini)
AI_MODEL=gpt-4o-mini
PORT=8787
